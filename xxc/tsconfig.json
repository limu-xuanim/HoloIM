{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["ES2021", "dom", "dom.iterable"],
        "module": "esnext",
        "noImplicitAny": true,
        "removeComments": false,
        "preserveConstEnums": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "sourceMap": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "strictNullChecks": true,
        "noEmit": true,
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "noImplicitThis": true,
        "allowJs": true,
        "noImplicitOverride": true,
        "paths": {
            "~/*": ["./*"],
            "Platform": ["./app/platform/electron"],
            "Platform/*": ["./app/platform/electron/*"]
        }
    },
    "include": ["app/**/*", "tools/**/*", "api-doc/**/*", "build/**/*", "webpack/**/*", "nodejs/**/*"],
    "exclude": [
        "node_modules",
        "release/**/*",
        "**/*.custom.ts",
        "app/dev-exts/**/*",
        "app/dist/**/*",
        "app/bin/**/*",
        "app/main.js",
        "app/assets/**/*"
    ]
}
