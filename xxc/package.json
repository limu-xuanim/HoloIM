{
    "name": "xuanxuan",
    "productName": "喧喧",
    "version": "10.4.0",
    "description": "专注于协同的聊天软件",
    "scripts": {
        "hot-server": "cross-env HOT=1 NODE_ENV=development node --max_old_space_size=2096 -r esbuild-register ./webpack/server.ts",
        "build-main": "cross-env NODE_ENV=production node -r esbuild-register ./node_modules/webpack/bin/webpack --config ./webpack/electron.main.production.ts --progress --profile",
        "build-renderer": "cross-env NODE_ENV=production node -r esbuild-register ./node_modules/webpack/bin/webpack --config ./webpack/electron.renderer.production.ts --progress --profile",
        "build-renderer-debug": "cross-env NODE_ENV=debug node -r esbuild-register ./node_modules/webpack/bin/webpack --config ./webpack/electron.renderer.debug.ts --progress --profile",
        "build-main-debug": "cross-env NODE_ENV=debug node -r esbuild-register ./node_modules/webpack/bin/webpack --config ./webpack/electron.main.production.ts --progress --profile",
        "build": "npm run build-main && npm run build-renderer",
        "build-debug": "npm run build-main-debug && npm run build-renderer-debug",
        "build-browser": "cross-env NODE_ENV=production node -r esbuild-register ./node_modules/webpack/bin/webpack --config ./webpack/browser.production.ts --progress --profile",
        "start": "npm run hot-server-browser",
        "start-hot": "cross-env HOT=1 NODE_ENV=development LOG=3 ELECTRON_DISABLE_SECURITY_WARNINGS=1 electron -r esbuild-register ./app/main.development --remote-debugging-port=9876 --trace-warnings",
        "start-hot-prod": "cross-env HOT=1 NODE_ENV=development LOG=0 electron -r esbuild-register ./app/main.development --remote-debugging-port=9876",
        "start-hot-perf": "cross-env HOT=1 NODE_ENV=development LOG=0 PERF=1 electron -r esbuild-register ./app/main.development --remote-debugging-port=9876",
        "start-hot-fast": "cross-env HOT=1 NODE_ENV=development SKIP_INSTALL_EXTENSIONS=1 electron -r esbuild-register ./app/main.development",
        "postinstall": "npm run package-config && cd ./app && npm install && cd ../ && electron-builder install-app-deps",
        "package": "node -r esbuild-register ./build/package.ts",
        "package-config": "npm run package -- --skipbuild",
        "package-beta": "npm run package -- --beta",
        "package-debug": "npm run package -- --debug",
        "package-mac": "npm run package -- --platform=mac --arch=x64",
        "package-mac-debug": "npm run package -- --platform=mac --arch=x64 --debug",
        "package-win": "npm run package -- --platform=win --arch=x64",
        "package-win-32": "npm run package -- --platform=win --arch=x32",
        "package-win-all": "npm run package -- --platform=win --arch=all",
        "package-linux": "npm run package -- --platform=linux --arch=x64",
        "package-linux-32": "npm run package -- --platform=linux --arch=x32",
        "package-win-debug": "npm run package -- --platform=win --arch=x64 --debug",
        "package-arm64": "npm run package -- --platform=linux --arch=arm64",
        "package-all": "npm run package -- --platform=all --arch=all --clean && npm run package -- --platform=mac,win --arch=x64 --debug",
        "package-all-test": "npm run package -- --platform=win,mac --arch=all --clean && npm run package -- --platform=mac,win --arch=x64 --debug",
        "package-all-beta": "npm run package -- --platform=all --arch=all --beta --clean && npm run package -- --platform=mac,win --arch=x64 --debug --beta",
        "package-browser": "npm run package -- --platform=browser",
        "package-publish": "npm run package-all -- --appimage",
        "hot-server-browser": "npm run hot-server -- --target=browser",
        "check-lang": "node --max_old_space_size=2096 -r esbuild-register ./tools/check-lang.ts",
        "check-duplicated-lang": "node -r esbuild-register ./tools/check-duplicated-lang.ts",
        "add-lang": "node -r esbuild-register ./tools/add-lang.ts",
        "json-api": "node -r esbuild-register ./tools/json-api.ts",
        "docs": "./node_modules/.bin/esdoc",
        "convert-api-scheme": "tsc && node --max_old_space_size=2096 -r esbuild-register ./tools/api-scheme-convert.js",
        "convert-twemoji": "node --max_old_space_size=2096 -r esbuild-register ./tools/convert-twemoji.js",
        "create-icons": "node --max_old_space_size=2096 -r esbuild-register ./build/create-icons.ts",
        "format": "npx @biomejs/biome format ./ --write",
        "lint": "npx @biomejs/biome lint ./ --apply"
    },
    "build": {
        "extends": "./build/electron-builder.json"
    },
    "bin": {
        "electron": "./node_modules/.bin/electron",
        "biome": "./node_modules/.bin/biome"
    },
    "author": {
        "name": "禅道软件（青岛）集团有限公司",
