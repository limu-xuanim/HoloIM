#
# This image provides an amd64 bootstrap Go plus build tools.
# The sw64 GCC/sysroot and the sw64 Go source tarball are mounted at runtime.

FROM debian:11

ENV DEBIAN_FRONTEND=noninteractive \
    GOROOT=/usr/local/go \
    GO111MODULE=on \
    GOTOOLCHAIN=auto \
    GOPROXY=https://goproxy.cn,direct \
    PATH=/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ARG APT_MIRROR=mirrors.aliyun.com
RUN set -eux; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|http://deb.debian.org/debian|http://${APT_MIRROR}/debian|g; s|http://security.debian.org/debian-security|http://${APT_MIRROR}/debian-security|g" /etc/apt/sources.list; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        make \
        patchelf \
        ca-certificates \
        curl \
        pkg-config \
        bzip2 \
    && rm -rf /var/lib/apt/lists/*

ARG GO_VERSION=1.25.4
RUN set -eux; \
    curl -fsSL "https://mirrors.aliyun.com/golang/go${GO_VERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xz; \
    /usr/local/go/bin/go version

RUN mkdir -p /work/xxd /work/xxb /opt/sw64-toolchain /tmp/go-sw64

WORKDIR /work
CMD ["/bin/bash"]
